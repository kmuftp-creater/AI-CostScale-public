.env
node_modules/
.next/
dashboard/node_modules/
dashboard/.next/
*.log
patch_groq.py
doc/*.bak-*
bridge/b.out
bridge/b.err
bridge/*.log

# 看板小幫手安裝包的設定檔含推送金鑰，絕不進版控
helper/helper-config.json

# 修改前的備份檔（.bak-YYYYMMDD），不進版控
*.bak-*

# 用完即刪的暫時工具資料夾（doc/_暫時-*），不進版控
doc/_暫時-*

# 隱藏桌面查證用的探針，原始碼進版控、編譯產物不進
bridge/hidden-desktop/*.exe

# 交付包裡的回報 token，絕不進版控（同 helper/helper-config.json 的理由）
doc/交付-*/_token.txt

# 交付包的壓縮檔不進版控——裡面含 _token.txt（2026-09-07 誤上傳過一次）
doc/*.rar
doc/*.zip
doc/*.7z

# 公開版：伺服器上的金鑰、佇列、備份、服務帳戶檔，絕不進版控
keys/
spool/
backups/
secrets/
*.key
*-sa.json
service-account*.json
.env.*
!.env.example

# 收集器預填的網址與 token（做成雙擊就好的包時用），含機密，不進版控
collector/_token.txt
collector/_url.txt

# 大屏「作戰指揮」外觀的私有素材（第三方圖檔），只放在本機與正式機，絕不進版控
dashboard/public/private/*
# 例外：網友設計、非官方的文字貼紙，User 明確允許放進公開版（2026-09-13）。
# 不在 MIT 授權範圍內，說明見 dashboard/public/private/THIRD-PARTY-NOTICE.md
!dashboard/public/private/alarm.png
!dashboard/public/private/sortie.png
!dashboard/public/private/berserk.png
!dashboard/public/private/secret.png
!dashboard/public/private/secret2.png
!dashboard/public/private/agency.png
!dashboard/public/private/power.png
!dashboard/public/private/THIRD-PARTY-NOTICE.md
