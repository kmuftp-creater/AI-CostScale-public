# 複製成 .env 之後填入實際值：cp .env.example .env
# .env 不進版本控制。等號兩邊不要留空白，值不要加引號。

# ── 資料庫 ──
DB_PASSWORD=change-me-strong-password

# ── 閘道（LiteLLM）──
# 主金鑰：管理 API 的權限，只放在伺服器上。建議 sk- 開頭加一段長亂數。
LITELLM_MASTER_KEY=sk-change-me

# ── 上游供應商的金鑰 ──
# 變數名稱要與 litellm-config.yaml 裡的 os.environ/xxx 一致。
# 沒有的先保留 placeholder，閘道照樣能啟動，只是那個模型打不通。
# 之後也可以在儀表板的「金鑰管理 → 新增上游金鑰」加，不用手改這裡。
# Google AI Studio 免費額度（gemini-flash-free，多把輪替）
GEMINI_FREE_KEY_1=placeholder
GEMINI_FREE_KEY_2=placeholder
GEMINI_FREE_KEY_3=placeholder
GEMINI_FREE_KEY_4=placeholder
GEMINI_FREE_KEY_5=placeholder
# Google AI Studio 付費金鑰（gemini-studio-paid）
GEMINI_PAID_KEY=placeholder
# Groq（groq-large、groq-fast）
GROQ_KEY_1=placeholder
GROQ_KEY_2=placeholder
GROQ_KEY_3=placeholder
# OpenRouter（openrouter-auto、openrouter-*）
OPENROUTER_API_KEY=placeholder
# 預留：設定檔裡這兩個模型預設是註解掉的，填了真金鑰再去打開
ANTHROPIC_API_KEY=placeholder
OPENAI_API_KEY=placeholder

# ── 訂閱橋接 ──
# 閘道呼叫你家用電腦上的橋接服務時帶的 token。
# 家用電腦那邊的使用者環境變數 BRIDGE_TOKEN 要設成**同一個值**。
BRIDGE_TOKEN=change-me-bridge-token

# ── 儀表板網址 ──
# 儀表板對外網址（Google 登入回呼、告警信連結、預算檢查都用它）
AUTH_URL=https://cost.example.com
# 閘道對外網址（「應用程式」頁給專案貼的接入範例）
GATEWAY_PUBLIC_URL=https://llm.example.com

# ── 儀表板登入（Google OAuth，白名單制）──
# 產生方式：openssl rand -base64 32
AUTH_SECRET=change-me-authjs-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 可以登入的 Google 帳號，逗號分隔
AUTH_ALLOWED_EMAILS=you@example.com
# 設成 1 會完全跳過登入，只能在本機開發時暫時用。**正式環境一定要是 0**，否則任何人都看得到你的花費。
AUTH_DISABLED=0

# ── 預算告警與排程 ──
# cron 呼叫 /api/budgets/check、/api/board/sync 用的固定 token。沒設定時那些端點回 503（停用）。
ALERT_CRON_TOKEN=change-me-cron-token
# 告警收件人，逗號分隔。留空時退回 AUTH_ALLOWED_EMAILS。
ALERT_EMAIL_TO=

# ── 寄信（任何 SMTP 服務都可以）──
# 沒設 SMTP_HOST／SMTP_FROM 時不寄信，但告警仍會寫進資料庫並顯示在儀表板橫幅。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── 訂閱用量回報 ──
# 你電腦上的 Claude Code／Codex 用量收集器回報時帶的 token。
# 沒設定時 /api/cli-usage 與 /api/otel 回 503，不會變成公開的寫入端點。
OTEL_INGEST_TOKEN=change-me-otel-token

# ── 專案看板（選用）──
# 讀取 GitHub repo 裡的 doc/status.json 用。沒設也能跑，看板只剩本機推送。
GITHUB_TOKEN=
# 各電腦的 helper/push-status.ps1 推送進度用。沒設＝停用（503）。
BOARD_PUSH_TOKEN=

# ── 外部系統讀花費（選用）──
# 外部系統在伺服器端讀「各專案本月 AI 花費」用。沒設時 /api/hub/spend 回 503。
HUB_API_TOKEN=

# ── Google Cloud（選用，只有用 Vertex AI 或要對 GCP 帳單時才需要）──
# 服務帳戶金鑰放在主機的 /root/vertex-sa.json（見 INSTALL.md）
# Vertex AI 的 GCP 專案 ID；不用 Vertex 就留空
VERTEX_PROJECT=
# 抓 Vertex 用量（Cloud Monitoring）用的專案 ID
GCP_PROJECT=
# 讀 BigQuery 帳單匯出時跑查詢的專案 ID
BQ_JOB_PROJECT=
